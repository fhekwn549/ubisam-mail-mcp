# Hanbiro mail MCP per-user settings
HANBIRO_SMTP_HOST="ubisam.hanbiro.net"
HANBIRO_SMTP_PORT="465"
HANBIRO_SMTP_USERNAME="your-email@ubisam.com"
HANBIRO_SMTP_PASSWORD="your-webmail-password"
HANBIRO_DEFAULT_FROM="your-email@ubisam.com"
HANBIRO_SMTP_USE_STARTTLS="false"
HANBIRO_SMTP_USE_TLS="true"
HANBIRO_SMTP_TLS_SERVERNAME="ubisam.hanbiro.net"

HANBIRO_IMAP_HOST="ubisam.hanbiro.net"
HANBIRO_IMAP_PORT="993"
HANBIRO_IMAP_USERNAME="your-email@ubisam.com"
HANBIRO_IMAP_PASSWORD="your-webmail-password"
HANBIRO_IMAP_USE_TLS="true"
HANBIRO_IMAP_TLS_SERVERNAME="ubisam.hanbiro.net"

HANBIRO_MAIL_MCP_DB="$HOME/.local/share/hanbiro-mail-mcp/mail.db"
