# Hanbiro mail MCP per-user settings
UBISAM_SMTP_HOST="ubisam.hanbiro.net"
UBISAM_SMTP_PORT="465"
UBISAM_SMTP_USERNAME="your-email@ubisam.com"
UBISAM_SMTP_PASSWORD="your-webmail-password"
UBISAM_DEFAULT_FROM="your-email@ubisam.com"
UBISAM_SMTP_USE_STARTTLS="false"
UBISAM_SMTP_USE_TLS="true"
UBISAM_SMTP_TLS_SERVERNAME="ubisam.hanbiro.net"

UBISAM_IMAP_HOST="ubisam.hanbiro.net"
UBISAM_IMAP_PORT="993"
UBISAM_IMAP_USERNAME="your-email@ubisam.com"
UBISAM_IMAP_PASSWORD="your-webmail-password"
UBISAM_IMAP_USE_TLS="true"
UBISAM_IMAP_TLS_SERVERNAME="ubisam.hanbiro.net"

UBISAM_MAIL_MCP_DB="$HOME/.local/share/ubisam-mail-mcp/mail.db"
